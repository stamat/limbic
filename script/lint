#!/bin/sh
# Syntax check only, on purpose: zero dependencies means no linter package.
# node --check catches what a missing linter would let a typo ship.
set -e
cd "$(dirname "$0")/.."
for f in src/*.js bin/*.js hooks/*.js; do
  node --check "$f"
done
echo "lint: ${0##*/} checked $(ls src/*.js bin/*.js hooks/*.js | wc -l | tr -d ' ') files"
